import tkinter as tk
from tkinter import ttk, messagebox
import json
import requests
import os
from datetime import datetime
# Главное окно
root = tk.Tk
()
root.title("Currency Converter")
root.geometry("600x500")
# Глобальные переменные
history = []
# Фрейм для ввода
input_frame = ttk.Frame(root)
input_frame.pack(pady=20, padx=20, fill="x")
# Выбор валюты «Из»
ttk.Label(input_frame, text="Из валюты:").grid(row=0, column=0, sticky="w")
from_currency = ttk.Combobox(input_frame, values=["USD", "EUR", "GBP", "JPY", "RUB", "CNY"])
from_currency.set("USD")
from_currency.grid(row=0, column=1, padx=5)
# Выбор валюты «В»
ttk.Label(input_frame, text="В валюту:").grid(row=1, column=0, sticky="w")
to_currency = ttk.Combobox(input_frame, values=["USD", "EUR", "GBP", "JPY", "RUB", "CNY"])
to_currency.set("EUR")
to_currency.grid(row=1, column=1, padx=5)
# Поле ввода суммы
ttk.Label(input_frame, text="Сумма:").grid(row=2, column=0, sticky="w")
amount_entry = ttk.Entry(input_frame)
amount_entry.grid(row=2, column=1, padx=5)
# Кнопка конвертации
convert_button = ttk.Button(input_frame, text="Конвертировать")
convert_button.grid(row=3, column=0, columnspan=2, pady=10)
# Метка для результата
result_label = ttk.Label(input_frame, text="Результат: ", font=("Arial", 12, "bold"))
result_label.grid(row=4, column=0, columnspan=2)
# Фрейм для истории
history_frame = ttk.Frame(root)
history_frame.pack(pady=10, padx=20, fill="both", expand=True)
# Таблица истории
columns = ("Дата", "Сумма", "Из", "В", "Результат")
history_tree = ttk.Treeview(history_frame, columns=columns, show="headings")
for col in columns:
    history_tree.heading(col, text=col)
    history_tree.column(col, width=100)
history_tree.pack(fill="both", expand=True)
def get_exchange_rate(from_curr, to_curr):
    """Получение курса через API"""
    try:
        # Используйте ваш API-ключ от exchangerate-api.com
        api_key = "YOUR_API_KEY"  # Замените на реальный ключ
        url = f"https://api.exchangerate-api.com/v4/latest/{from_curr}"
        response = requests.get(url)
        data = response.json()
        if response.status_code == 200 and to_curr in data["rates"]:
            return data["rates"][to_curr]
        else:
            messagebox.showerror("Ошибка", "Не удалось получить курс валюты")
            return None
    except Exception as e:
        messagebox.showerror("Ошибка", f"Ошибка подключения: {e}")
        return None
def convert_currency():
    """Конвертация валюты"""
    # Проверка ввода
    try:
        amount = float(amount_entry.get())
        if amount <= 0:
            messagebox.showerror("Ошибка", "Сумма должна быть положительным числом")
            return
    except ValueError:
        messagebox.showerror("Ошибка", "Введите корректное число")
        return
    from_curr = from_currency.get()
    to_curr = to_currency.get()
    if from_curr == to_curr:
        result = amount
    else:
        rate = get_exchange_rate(from_curr, to_curr)
        if rate is None:
            return
        result = amount * rate
    # Отображение результата
    result_label.config(text=f"Результат: {result:.2f} {to_curr}")
    # Добавление в историю
    record = {
        "date": datetime.now
().strftime("%Y-%m-%d %H:%M:%S"),
        "amount": amount,
        "from": from_curr,
        "to": to_curr,
        "result": round(result, 2)
    }
    history.append(record)
    update_history_table()
    save_history()
def update_history_table():
    """Обновление таблицы истории"""
    for item in history_tree.get_children():
        history_tree.delete(item)
    for record in reversed(history):  # Последние записи сверху
        history_tree.insert("", "end", values=(
            record["date"],
            record["amount"],
            record["from"],
            record["to"],
            record["result"]
        ))
def save_history():
    """Сохранение истории в JSON"""
    with open("currency_history.json", "w", encoding="utf-8") as f:
        json.dump(history, f, ensure_ascii=False, indent=4)
def load_history():
    """Загрузка истории из JSON"""
    global history
    if os.path.exists("currency_history.json"):
        try:
            with open("currency_history.json", "r", encoding="utf-8") as f:
                history = json.load(f)
            update_history_table()
        except Exception as e:
            messagebox.showwarning("Предупреждение", f"Не удалось загрузить историю: {e}")
convert_button.config(command=convert_currency)
# Меню для управления историей
menu_bar = tk.Menu
(root)
file_menu = tk.Menu
(menu_bar, tearoff=0)
file_menu.add_command(label="Сохранить историю", command=save_history)
file_menu.add_command(label="Загрузить историю", command=load_history)
menu_bar.add_cascade(label="Файл", menu=file_menu)
root.config(menu=menu_bar)
