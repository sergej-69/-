import tkinter as tk
from tkinter import ttk
from tkinter import messagebox
import json
from datetime import datetime
import os

class TrainingPlanner:
    def __init__(self, root):
        self.root = root
        self.root.title("Training Planner")
        self.root.geometry("800x600")

        self.trainings = []
        self.data_file = "trainings.json"

        self.create_widgets()
        self.load_trainings()
        self.update_table()

    def create_widgets(self):
        # --- Фрейм для ввода данных ---
        input_frame = ttk.LabelFrame(self.root, text="Добавить тренировку")
        input_frame.pack(pady=10, padx=10, fill="x")

        # Дата
        ttk.Label(input_frame, text="Дата (YYYY-MM-DD):").grid(row=0, column=0, padx=5, pady=5, sticky="w")
        self.date_entry = ttk.Entry(input_frame, width=20)
        self.date_entry.grid(row=0, column=1, padx=5, pady=5)
        self.date_entry.insert(0, datetime.now().strftime("%Y-%m-%d")) # Предзаполнение текущей датой

        # Тип тренировки
        ttk.Label(input_frame, text="Тип тренировки:").grid(row=1, column=0, padx=5, pady=5, sticky="w")
        self.training_type_entry = ttk.Entry(input_frame, width=30)
        self.training_type_entry.grid(row=1, column=1, padx=5, pady=5)

        # Длительность
        ttk.Label(input_frame, text="Длительность (мин):").grid(row=2, column=0, padx=5, pady=5, sticky="w")
        self.duration_entry = ttk.Entry(input_frame, width=10)
        self.duration_entry.grid(row=2, column=1, padx=5, pady=5)

        # Кнопка добавить
        add_button = ttk.Button(input_frame, text="Добавить тренировку", command=self.add_training)
        add_button.grid(row=3, column=0, columnspan=2, pady=10)

        # --- Фрейм для фильтрации ---
        filter_frame = ttk.LabelFrame(self.root, text="Фильтр")
        filter_frame.pack(pady=10, padx=10, fill="x")

        ttk.Label(filter_frame, text="Тип тренировки:").grid(row=0, column=0, padx=5, pady=5, sticky="w")
        self.filter_type_entry = ttk.Entry(filter_frame, width=20)
        self.filter_type_entry.grid(row=0, column=1, padx=5, pady=5)
        self.filter_type_entry.bind("<KeyRelease>", lambda event=None: self.apply_filters())

        ttk.Label(filter_frame, text="Дата от (YYYY-MM-DD):").grid(row=1, column=0, padx=5, pady=5, sticky="w")
        self.filter_date_from_entry = ttk.Entry(filter_frame, width=15)
        self.filter_date_from_entry.grid(row=1, column=1, padx=5, pady=5)
        self.filter_date_from_entry.bind("<KeyRelease>", lambda event=None: self.apply_filters())

        ttk.Label(filter_frame, text="Дата до (YYYY-MM-DD):").grid(row=1, column=2, padx=5, pady=5, sticky="w")
        self.filter_date_to_entry = ttk.Entry(filter_frame, width=15)
        self.filter_date_to_entry.grid(row=1, column=3, padx=5, pady=5)
        self.filter_date_to_entry.bind("<KeyRelease>", lambda event=None: self.apply_filters())

        ttk.Button(filter_frame, text="Сбросить фильтры", command=self.reset_filters).grid(row=0, column=4, rowspan=2, padx=10, pady=5)


        # --- Таблица для отображения тренировок ---
        table_frame = ttk.Frame(self.root)
        table_frame.pack(pady=10, padx=10, fill="both", expand=True)

        self.tree = ttk.Treeview(table_frame, columns=("Date", "Type", "Duration"), show="headings")
        self.tree.heading("Date", text="Дата")
        self.tree.heading("Type", text="Тип тренировки")
        self.tree.heading("Duration", text="Длительность (мин)")

        self.tree.column("Date", width=100, anchor="center")
        self.tree.column("Type", width=150, anchor="w")
        self.tree.column("Duration", width=80, anchor="center")

        self.tree.pack(side="left", fill="both", expand=True)

        # Scrollbar
        scrollbar = ttk.Scrollbar(table_frame, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        scrollbar.pack(side="right", fill="y")

        # --- Кнопки управления (ть/Загрузить) ---
        self.root.protocol("WM_DELETE_WINDOW", self.on_closing) # Обработка закрытия окна
        save_button = ttk.Button(self.root, text="Сохранить данные", command=self.save_trainings_to_json)
        save_button.pack(pady=5)

    def validate_date(self, date_str):
        try:
            datetime.strptime(date_str, "%Y-%m-%d")
            return True
        except ValueError:
            return False

    def validate_duration(self, duration_str):
        if duration_str.isdigit():
            duration = int(duration_str)
            return duration > 0
        return False

    def add_training(self):
        date = self.date_entry.get()
        training_type = self.training_type_entry.get()
        duration = self.duration_entry.get()

        # Проверка корректности ввода
        if not self.validate_date(date):
            messagebox.showerror("Ошибка ввода", "Неверный формат даты. Используйте YYYY-MM-DD.")
            return
        if not self.validate_duration(duration):
            messagebox.showerror("Ошибка ввода", "Длительность должна быть положительным числом.")
            return

        self.trainings.append({"date": date, "type": training_type, "duration": int(duration)})
        self.update_table()
        self.clear_input_fields()
        self.save_trainings_to_json() # Автосохранение при добавлении

    def clear_input_fields(self):
        self.date_entry.delete(0, tk.END)
        self.training_type_entry.delete(0, tk.END)
        self.duration_entry.delete(0, tk.END)
        self.date_entry.insert(0, datetime.now().strftime("%Y-%m-%d")) # Сброс на текущую дату

    def update_table(self, filtered_trainings=None):
        # Удаляем все текущие элементы из таблицы
        for item in self.tree.get_children():
            self.tree.delete(item)

        # Вставляем новые данные (отфильтрованные или все)
        data_to_display = filtered_trainings if filtered_trainings is not None else self.trainings
        for training in data_to_display:
            self.tree.insert("", tk.END, values=(training["date"], training["type"], training["duration"]))

    def load_trainings(self):
        if os.path.exists(self.data_file):
            try:
                with open(self.data_file, "r", encoding="utf-8") as f:
                    self.trainings = json.load(f)
            except json.JSONDecodeError:
                messagebox.showerror("Ошибка загрузки", "Файл JSON поврежден. Будет создан новый файл.")
                self.trainings = []
        else:
            self.trainings = []

    def save_trainings_to_json(self):
        try:
            with open(self.data_file, "w", encoding="utf-8") as f:
                json.dump(self.trainings, f, indent=4, ensure_ascii=False)
        except IOError:
            messagebox.showerror("Ошибка сохранения", "Не удалось сохранить данные в файл.")

    def on_closing(self):
        if messagebox.askokcancel("Выход", "Вы хотите сохранить изменения перед выходом?"):
            self.save_trainings_to_json()
        self.root.destroy()

    def apply_filters(self):
        filter_type = self.filter_type_entry.get().lower()
        date_from_str = self.filter_date_from_entry.get()
        date_to_str = self.filter_date_to_entry.get()

        filtered_list = self.trainings

        # Фильтр по типу тренировки
        if filter_type:
            filtered_list = [t for t in filtered_list if filter_type in t["type"].lower()]

        # Фильтр по дате ОТ
        if date_from_str:
            if not self.validate_date(date_from_str):
                messagebox.showwarning("Предупреждение", "Неверный формат стартовой даты фильтра. Используйте YYYY-MM-DD.")
                # Не применяем этот фильтр, если формат некорректен
            else:
                try:
                    date_from = datetime.strptime(date_from_str, "%Y-%m-%d")
                    filtered_list = [t for t in filtered_list if datetime.strptime(t["date"], "%Y-%m-%d") >= except ValueError: # На всякий случай, если в данных есть некорректные даты
                    pass

        # Фильтр по дате ДО
        if date_to_str:
            if not self.validate_date(date_to_str):
                messagebox.showwarning("Предупреждение", "Неверный формат конечной даты фильтра. Используйте YYYY-MM-DD.")
                # Не применяем этот фильтр, если формат некорректен
            else:
                try:
                    date_to = datetime.strptime(date_to_str, "%Y-%m-%d")
                    filtered_list = [t for t in filtered_list if datetime.strptime(t["date"], "%Y-%m-%d") <= date_to]
                except ValueError:
                    pass

        self.update_table(filtered_list)

    def reset_filters(self):
        self.filter_type_entry.delete(0, tk.END)
        self.filter_date_from_entry.delete(0, tk.END)
        self.filter_date_to_entry.delete(0, tk.END)
        self.apply_filters() # Перерисовать всю таблицу без фильтров

if __name__ == "__main__":
    root = tk.Tk()
    app = TrainingPlanner(root)
    root.mainloop()










