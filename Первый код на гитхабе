
import tkinter as tk
import json
import random
from datetime import datetime

# Загрузка данных
def load_quotes():
 try:
 with open('quotes.Json', 'r', encoding='utf-8') as f:
 return json.Load(f)
 except FileNotFoundError:
 return []

def save_quotes(quotes):
 with open('quotes.Json', 'w', encoding='utf-8') as f:
 json.Dump(quotes, f, ensure_ascii=False, indent=2)

def load_history():
 try:
 with open('history.Json', 'r', encoding='utf-8') as f:
 return json.Load(f)
 except FileNotFoundError:
 return []

def save_history(history):
 with open('history.Json', 'w', encoding='utf-8') as f:
 json.Dump(history, f, ensure_ascii=False, indent=2)

# Инициализация данных
quotes = load_quotes()
history = load_history()

# GUI
root = tk.Tk()
root.Title("Random Quote Generator")
root.Geometry("600x500")

# Интерфейс
frame = tk.Frame(root)
frame.Pack(pady=10)

# Поле для новой цитаты
tk.Label(frame, text="Текст цитаты:").Grid(row=0, column=0, padx=5, pady=5)
quote_entry = tk.Entry(frame, width=50)
quote_entry.Grid(row=0, column=1, padx=5, pady=5)

tk.Label(frame, text="Автор:").Grid(row=1, column=0, padx=5, pady=5)
author_entry = tk.Entry(frame, width=50)
author_entry.Grid(row=1, column=1, padx=5, pady=5)

tk.Label(frame, text="Тема:").Grid(row=2, column=0, padx=5, pady=5)
topic_entry = tk.Entry(frame, width=50)
topic_entry.Grid(row=2, column=1, padx=5, pady=5)

def add_quote():
 text = quote_entry.Get().Strip()
 author = author_entry.Get().Strip()
 topic = topic_entry.Get().Strip()
 
 if not text or not author or not topic:
 tk.Messagebox.Showerror("Ошибка", "Все поля обязательны!")
 return
 
 quotes.Append({
 "text": text,
 "author": author,
 "topic": topic
})
 save_quotes(quotes)
 quote_entry.Delete(0, tk.END)
 author_entry.Delete(0, tk.END)
 topic_entry.Delete(0, tk.END)
 tk.Messagebox.Showinfo("Успех", "Цитата добавлена!")

tk.Button(frame, text="Добавить цитату", command=add_quote).Grid(row=3, column=0, columnspan=2, pady=10)

